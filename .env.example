# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_SECRET_TOKEN=optional_secret_random_string_for_webhook_security

# Application URL (your Vercel project domain, e.g. https://my-energy-bot.vercel.app)
APP_URL=https://your-vercel-domain.vercel.app

# Upstash Redis / Vercel KV Configuration (Free on Vercel Dashboard or upstash.com)
UPSTASH_REDIS_REST_URL=https://your-redis-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# FatSecret Developer Credentials (App keys)
# Register at https://platform.fatsecret.com
FATSECRET_CLIENT_ID=your_fatsecret_client_id
FATSECRET_CLIENT_SECRET=your_fatsecret_client_secret

# Google Cloud OAuth Credentials (Web Application)
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional fallback single-user tokens (if not using web auth)
GOOGLE_REFRESH_TOKEN=
FATSECRET_ACCESS_TOKEN=

# User Timezone for daily aggregation (00:00:00 - now)
USER_TIMEZONE=Europe/Moscow
